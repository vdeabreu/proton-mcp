# Copy to .env (chmod 600) and fill in. Never commit .env.

# Bridge credentials shown by `protonmail-bridge --cli` -> `info` (NOT your Proton password)
PROTON_BRIDGE_USER=
PROTON_BRIDGE_PASSWORD=

# Password asked on the OAuth page when adding the claude.ai connector (20+ characters)
# Generate one with: openssl rand -base64 30
MCP_PASSWORD=

# Public base URL of the server (your reverse proxy vhost), without trailing slash
PUBLIC_URL=https://mcp.example.com

# Register send_email? Keep false until reading works and you really want sending.
ENABLE_SEND=false

# Language of the "On <date>, <sender> wrote:" line in replies: en or fr
# PROTON_QUOTE_LANG=en

# Name shown in From ("Jane Doe <jane@proton.me>"). Leave unset to reuse the name
# found on your recent messages in Sent; set it empty to send the bare address.
# PROTON_SENDER_NAME=Jane Doe

# Optional
# PORT=8766
# LISTEN_HOST=127.0.0.1
# OAuth redirect URIs a client may register (comma-separated). Default: claude.ai's callback.
# ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
